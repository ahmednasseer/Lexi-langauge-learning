# ==================== DATABASE ====================
DATABASE_URL="postgresql://postgres:password@localhost:5432/lexi?schema=public"

# ==================== JWT ====================
# IMPORTANT: Replace with a random 64+ character string in production.
# Run: openssl rand -hex 64
JWT_SECRET="change-this-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"

# ==================== OPENAI ====================
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# ==================== STRIPE ====================
STRIPE_SECRET_KEY="sk_test_your-stripe-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# ==================== REDIS ====================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==================== S3 / CLOUDFLARE R2 ====================
S3_BUCKET="lexi-audio"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"

# ==================== MONITORING ====================
SENTRY_DSN="https://your-sentry-dsn"
SENTRY_ENVIRONMENT="development"

# ==================== APP ====================
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ==================== FIREBASE ADMIN ====================
# Path (relative to backend/ cwd) to a Firebase service account JSON.
# If unset, the service auto-discovers *-firebase-adminsdk-*.json under scripts/
FIREBASE_SERVICE_ACCOUNT_PATH="./../scripts/lexi-33b14-firebase-adminsdk-fbsvc-133d5568e2.json"
FIREBASE_PROJECT_ID="lexi-33b14"

# ==================== EMAIL (optional) ====================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
