generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS ====================
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String?
  avatar            String?
  provider          String    @default("local") // local, google, apple, guest
  providerId        String?
  nativeLanguage    String?
  learningLanguage  String?
  level             String    @default("A1")
  xp                Int       @default(0)
  totalXp           Int       @default(0)
  streak            Int       @default(0)
  bestStreak        Int       @default(0)
  dailyXp           Int       @default(0)
  dailyGoal         Int       @default(50)
  learningGoal      String?   // Travel, Work, Study, Conversation, Hobby
  isPremium         Boolean   @default(false)
  isActive          Boolean   @default(true)
  role              String    @default("user") // user, admin
  subscriptionId    String?
  subscriptionEnd   DateTime?
  lastActiveAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  progress              UserProgress[]
  chatHistory           ChatHistory[]
  achievements          UserAchievement[]
  learningPlan          LearningPlan[]
  aiUsage               AiUsage[]
  audioFiles            AudioFile[]
  subscriptions         Subscription[]
  blockedUsers          BlockedUser[] @relation("UserBlocker")
  blockedBy             BlockedUser[] @relation("UserBlocked")
  reportsGiven          UserReport[] @relation("ReporterUser")
  reportsReceived       UserReport[] @relation("ReportedUser")
  sentMessages          Message[] @relation("MessageSender")
  receivedMessages      Message[] @relation("MessageReceiver")
  sentRequests          MessageRequest[] @relation("RequestSender")
  receivedRequests      MessageRequest[] @relation("RequestReceiver")
  pronunciationAttempts PronunciationAttempt[]
  listeningProgress     ListeningProgress[]
  dailyMissions         DailyMission[]
  certificates          Certificate[]
  badges                UserBadge[]
  passport              Passport?
  gemsWallet            GemsWallet?
  transactions          Transaction[]
  inventory             UserInventory[]
  groupMemberships      GroupMember[]
  posts                 Post[]
  likes                 Like[]
  comments              Comment[]
  challenges            UserChallenge[]
  userAvatar            UserAvatar?
  aiConversations       AiConversation[]
  aiLearningMemories    AiLearningMemory[]
  mockExams             MockExam[]
  writingSubmissions    WritingSubmission[]
  userProfile           UserProfile?
  learningProfile       LearningProfile?

  @@index([email])
  @@index([provider, providerId])
  @@index([isActive])
  @@index([role])
}

// ==================== LESSONS ====================
model Language {
  id          String   @id @default(cuid())
  code        String   @unique // en, ar, fr, es, de, it
  name        String
  nativeName  String
  flag        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  languageId  String
  language    Language @relation(fields: [languageId], references: [id])
  level       String   // A1, A2, B1, B2, C1, C2
  category    String   // Vocabulary, Grammar, Listening, Speaking
  title       String
  description String
  content     Json     // Flexible content storage
  xpReward    Int      @default(50)
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(false)
  audioKey    String?  // S3 key for lesson audio
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vocabulary  Vocabulary[]
  grammar     GrammarRule[]
  quiz        QuizQuestion[]
  progress    UserProgress[]

  @@index([languageId, level, category])
  @@index([isPublished])
}

model Vocabulary {
  id                String   @id @default(cuid())
  lessonId          String
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word              String
  translation       String
  pronunciation     String?
  audioUrl          String?
  audioKey          String?  // S3 key for word audio
  imageUrl          String?
  example           String
  exampleTranslation String
  orderIndex        Int      @default(0)

  @@index([lessonId])
}

model GrammarRule {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  explanation String
  examples    String[] // PostgreSQL array
  tip         String?

  @@index([lessonId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String
  correctAnswer String
  options       String[] // PostgreSQL array
  explanation   String?
  type          String   @default("multiple_choice")
  orderIndex    Int      @default(0)

  @@index([lessonId])
}

// ==================== USER PROGRESS ====================
model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score       Float
  completed   Boolean  @default(false)
  timeSpent   Int      @default(0) // seconds
  xpEarned    Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ==================== AI CHAT ====================
model ChatHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  aiResponse  String
  correction  String?
  explanation String?
  tokensUsed  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ==================== AI USAGE TRACKING ====================
model AiUsage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  messagesCount Int      @default(0)
  tokensUsed    Int      @default(0)
  model         String   @default("gpt-4o-mini")
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

// ==================== AUDIO FILES ====================
model AudioFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String   // S3/R2 key
  url           String   // Public URL
  fileName      String
  fileSize      Int      // bytes
  format        String   // mp3, wav, ogg
  duration      Float?   // seconds
  language      String
  level         String?
  category      String   // tts, pronunciation, lesson
  transcription String?  // For pronunciation scoring
  score         Float?   // Pronunciation score 0-100
  createdAt     DateTime @default(now())

  @@index([userId, language])
  @@index([key])
}

// ==================== ACHIEVEMENTS ====================
model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  type        String   // lessons, words, streak, quiz, pronunciation, chat, days
  targetValue Int
  xpReward    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ==================== LEARNING PLAN ====================
model LearningPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  planData    Json     // AI-generated plan
  startDate   DateTime @default(now())
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId, isActive])
}

// ==================== SUBSCRIPTIONS ====================
model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String   // monthly, yearly
  status        String   @default("active") // active, cancelled, expired
  provider      String   // stripe, revenuecat
  externalId    String?
  startDate     DateTime @default(now())
  endDate       DateTime
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([externalId])
}

// ==================== PAYMENT TRANSACTIONS ====================
model PaymentTransaction {
  id            String   @id @default(cuid())
  userId        String
  subscriptionId String
  amount        Int      // cents
  currency      String   @default("usd")
  status        String   // pending, completed, failed, refunded
  provider      String   // stripe
  externalId    String?  // Stripe payment intent ID
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([externalId])
  @@index([createdAt])
}

// ==================== SPEAKING & LISTENING ====================
model PronunciationAttempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spokenText    String
  targetText    String
  accuracy      Float
  fluency       Float
  grammar       Float
  overallScore  Float
  xpEarned      Int      @default(0)
  level         String   @default("A1")
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ListeningProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  isCorrect     Boolean
  score         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SpeakingExercise {
  id            String   @id @default(cuid())
  level         String
  sentence      String
  translation   String
  audioUrl      String?
  category      String
  difficulty    Int      @default(1)
  xpReward      Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([level])
  @@index([category])
}

// ==================== DAILY MISSIONS ====================
model DailyMission {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId     String
  title         String
  description   String
  type          String
  target        Int
  progress      Int      @default(0)
  rewardXp      Int      @default(0)
  rewardGems    Int      @default(0)
  icon          String
  isCompleted   Boolean  @default(false)
  isClaimed     Boolean  @default(false)
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId, date])
  @@index([userId, type])
}

// ==================== CERTIFICATES ====================
model Certificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  level           String
  levelTitle      String
  totalXp         Int      @default(0)
  certificateCode String   @unique
  issuedAt        DateTime @default(now())

  @@index([userId])
  @@index([certificateCode])
}

// ==================== ACHIEVEMENTS ====================
model UserBadge {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId       String
  unlockedAt    DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// ==================== PASSPORT ====================
model Passport {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel      String   @default("A1")
  totalXp           Int      @default(0)
  currentStreak     Int      @default(0)
  bestStreak        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// ==================== GEMS WALLET ====================
model GemsWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gems            Int      @default(100)
  totalPurchased  Int      @default(0)
  totalSpent      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ==================== TRANSACTIONS ====================
model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // purchase, reward, spending, bundle, refund
  amount        Int
  description   String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==================== STORE ITEMS ====================
model StoreItem {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String   // avatar, frame, background, gems, bundle
  price         Int
  imageUrl      String?
  isPremium     Boolean  @default(false)
  isLimited     Boolean  @default(false)
  availableUntil DateTime?
  metadata      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  inventory     UserInventory[]

  @@index([category])
  @@index([isActive])
}

// ==================== USER INVENTORY ====================
model UserInventory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId        String
  item          StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  purchasedAt   DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

// ==================== USER AVATAR ====================
model UserAvatar {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId        String   @default("avatar_1")
  frameId         String?
  backgroundId    String?
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ==================== COMMUNITY ====================
model CommunityGroup {
  id            String   @id @default(cuid())
  name          String
  description   String
  level         String
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  members       GroupMember[]
  posts         Post[]
}

model GroupMember {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String
  group         CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt      DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Post {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  type          String   // achievement, question, challenge, discussion, tip
  groupId       String?
  group         CommunityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  likes         Like[]
  comments      Comment[]

  @@index([userId])
  @@index([groupId])
  @@index([createdAt])
}

model Like {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          String
  createdAt     DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Challenge {
  id            String   @id @default(cuid())
  title         String
  description   String
  icon          String
  duration      String   // weekly, monthly
  targetProgress Int
  rewardXp      Int
  rewardGems    Int
  badgeId       String?
  isActive      Boolean  @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())

  participants  UserChallenge[]
}

model UserChallenge {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress      Int      @default(0)
  isCompleted   Boolean  @default(false)
  isClaimed     Boolean  @default(false)
  joinedAt      DateTime @default(now())

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
}

// ==================== MESSAGING ====================
model Message {
  id            String   @id @default(cuid())
  senderId      String
  sender        User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  reports       UserReport[]

  @@index([senderId])
  @@index([receiverId])
}

model MessageRequest {
  id            String   @id @default(cuid())
  senderId      String
  sender        User     @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User     @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, BLOCKED
  createdAt     DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model BlockedUser {
  id            String   @id @default(cuid())
  blockerId     String
  blocker       User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId     String
  blocked       User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id              String   @id @default(cuid())
  reporterId      String
  reporter        User     @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId  String
  reported        User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  messageId       String?
  message         Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reason          String   // spam, harassment, inappropriateContent, other
  description     String?
  status          String   @default("pending") // pending, reviewed, resolved, dismissed
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  @@unique([reporterId, reportedUserId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacySetting  String   @default("friendsOnly") // everyone, friendsOnly, groupMembersOnly, disabled
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ==================== AI LEARNING INTELLIGENCE ====================
model LearningProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel      String   @default("A1")
  learningGoal      String   @default("conversation") // travel, work, study, conversation, hobby, goetheExam
  dailyMinutes      Int      @default(15)
  weakAreas         Json     @default("[]")
  strongAreas       Json     @default("[]")
  preferredTopics   Json     @default("[\"Greetings\", \"Numbers\", \"Colors\"]")
  learningSpeed     String   @default("normal") // slow, normal, fast
  lastAnalysisDate  DateTime @default(now())
  totalStudyHours   Int      @default(0)
  currentStreak     Int      @default(0)
  overallProgress   Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recommendations   AIRecommendation[]
  studyPlans        StudyPlan[]
  studentMemory     StudentMemory?

  @@index([userId])
  @@index([currentLevel])
  @@index([learningGoal])
}

model AIRecommendation {
  id                String   @id @default(cuid())
  userId            String
  profile           LearningProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type              String   // weakness_fix, review, new_topic, challenge, daily
  title             String
  description       String
  category          String
  estimatedMinutes  Int      @default(5)
  priority          Int      @default(5) // 1-10
  isCompleted       Boolean  @default(false)
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([isCompleted])
}

model StudyPlan {
  id            String   @id @default(cuid())
  userId        String
  profile       LearningProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  title         String
  startDate     DateTime
  endDate       DateTime
  days          Json     // Array of day plans
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([isActive])
}

model StudentMemory {
  id                    String   @id @default(cuid())
  userId                String   @unique
  profile               LearningProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  mistakePatterns       Json     @default("[]")
  successfullyLearned   Json     @default("[]")
  conversationHistory   Json     @default("[]")
  preferences           Json     @default("{\"preferredDifficulty\":\"intermediate\",\"favoriteTopics\":[],\"feedbackStyle\":\"gentle\",\"showTranslations\":true,\"audioEnabled\":true}")
  lastUpdated           DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([userId])
}

// ==================== AI COACH ====================
model AiConversation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message         String
  response        String
  category        String   @default("free")
  level           String   @default("A1")
  hasCorrection   Boolean  @default(false)
  xpEarned        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
}

model AiLearningMemory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mistakeType     String   // grammar, vocabulary, pronunciation
  wrongSentence   String
  correctSentence String
  explanation     String
  languageLevel   String   @default("A1")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ==================== GOETHE EXAMS ====================
model MockExam {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level             String   // A1, A2, B1, B2, C1, C2
  score             Int      @default(0)
  totalPoints       Int      @default(0)
  timeSpentSeconds  Int      @default(0)
  completedSections Json     @default("[]")
  result            Json     @default("{}")
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([level])
}

model WritingSubmission {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level           String   @default("A1")
  prompt          String
  submissionText  String
  feedback        Json     @default("{}")
  score           Int      @default(0)
  submittedAt     DateTime @default(now())

  @@index([userId])
}
