generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  password              String?
  avatar                String?
  provider              String                 @default("local")
  providerId            String?
  nativeLanguage        String?
  learningLanguage      String?
  level                 String                 @default("A1")
  xp                    Int                    @default(0)
  totalXp               Int                    @default(0)
  streak                Int                    @default(0)
  bestStreak            Int                    @default(0)
  dailyXp               Int                    @default(0)
  dailyGoal             Int                    @default(50)
  learningGoal          String?
  isPremium             Boolean                @default(false)
  isActive              Boolean                @default(true)
  role                  String                 @default("user")
  subscriptionId        String?
  subscriptionEnd       DateTime?
  lastActiveAt          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  aiConversations       AiConversation[]
  aiLearningMemories    AiLearningMemory[]
  aiUsage               AiUsage[]
  audioFiles            AudioFile[]
  blockedBy             BlockedUser[]          @relation("UserBlocked")
  blockedUsers          BlockedUser[]          @relation("UserBlocker")
  certificates          Certificate[]
  chatHistory           ChatHistory[]
  comments              Comment[]
  dailyBonusClaims      DailyBonusClaim[]
  dailyMissions         DailyMission[]
  gemsWallet            GemsWallet?
  groupMemberships      GroupMember[]
  learningPlan          LearningPlan[]
  learningProfile       LearningProfile?
  likes                 Like[]
  listeningProgress     ListeningProgress[]
  receivedMessages      Message[]              @relation("MessageReceiver")
  sentMessages          Message[]              @relation("MessageSender")
  receivedRequests      MessageRequest[]       @relation("RequestReceiver")
  sentRequests          MessageRequest[]       @relation("RequestSender")
  mockExams             MockExam[]
  passport              Passport?
  posts                 Post[]
  pronunciationAttempts PronunciationAttempt[]
  subscriptions         Subscription[]
  transactions          Transaction[]
  achievements          UserAchievement[]
  userAvatar            UserAvatar?
  badges                UserBadge[]
  challenges            UserChallenge[]
  inventory             UserInventory[]
  userProfile           UserProfile?
  progress              UserProgress[]
  reportsReceived       UserReport[]           @relation("ReportedUser")
  reportsGiven          UserReport[]           @relation("ReporterUser")
  writingSubmissions    WritingSubmission[]

  @@index([email])
  @@index([provider, providerId])
  @@index([isActive])
  @@index([role])
}

model Language {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nativeName String
  flag       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  lessons    Lesson[]
}

model Lesson {
  id          String         @id @default(cuid())
  languageId  String
  level       String
  category    String
  title       String
  description String
  content     Json
  xpReward    Int            @default(50)
  orderIndex  Int            @default(0)
  isPublished Boolean        @default(false)
  audioKey    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  grammar     GrammarRule[]
  language    Language       @relation(fields: [languageId], references: [id])
  quiz        QuizQuestion[]
  progress    UserProgress[]
  vocabulary  Vocabulary[]

  @@index([languageId, level, category])
  @@index([isPublished])
}

model Vocabulary {
  id                 String  @id @default(cuid())
  lessonId           String
  word               String
  translation        String
  pronunciation      String?
  audioUrl           String?
  audioKey           String?
  imageUrl           String?
  example            String
  exampleTranslation String
  orderIndex         Int     @default(0)
  lesson             Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model GrammarRule {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  explanation String
  examples    String[]
  tip         String?
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String
  question      String
  correctAnswer String
  options       String[]
  explanation   String?
  type          String   @default("multiple_choice")
  orderIndex    Int      @default(0)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  score       Float
  completed   Boolean  @default(false)
  timeSpent   Int      @default(0)
  xpEarned    Int      @default(0)
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model ChatHistory {
  id          String   @id @default(cuid())
  userId      String
  message     String
  aiResponse  String
  correction  String?
  explanation String?
  tokensUsed  Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiUsage {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  messagesCount Int      @default(0)
  tokensUsed    Int      @default(0)
  model         String   @default("gpt-4o-mini")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model AudioFile {
  id            String   @id @default(cuid())
  userId        String
  key           String
  url           String
  fileName      String
  fileSize      Int
  format        String
  duration      Float?
  language      String
  level         String?
  category      String
  transcription String?
  score         Float?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, language])
  @@index([key])
}

model Achievement {
  id          String            @id @default(cuid())
  title       String
  description String
  icon        String
  type        String
  targetValue Int
  xpReward    Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model LearningPlan {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String
  planData    Json
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  planId      String
  status      String    @default("active")
  provider    String
  externalId  String?   @unique
  startDate   DateTime  @default(now())
  endDate     DateTime
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String
  amount         Int
  currency       String   @default("usd")
  status         String
  provider       String
  externalId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([externalId])
  @@index([createdAt])
}

model PronunciationAttempt {
  id           String   @id @default(cuid())
  userId       String
  spokenText   String
  targetText   String
  accuracy     Float
  fluency      Float
  grammar      Float
  overallScore Float
  xpEarned     Int      @default(0)
  level        String   @default("A1")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ListeningProgress {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  isCorrect  Boolean
  score      Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SpeakingExercise {
  id          String   @id @default(cuid())
  level       String
  sentence    String
  translation String
  audioUrl    String?
  category    String
  difficulty  Int      @default(1)
  xpReward    Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([level])
  @@index([category])
}

model DailyMission {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  title       String
  description String
  type        String
  target      Int
  progress    Int      @default(0)
  rewardXp    Int      @default(0)
  rewardGems  Int      @default(0)
  icon        String
  isCompleted Boolean  @default(false)
  isClaimed   Boolean  @default(false)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, date])
  @@index([userId, date])
  @@index([userId, type])
}

model DailyBonusClaim {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  userName        String
  level           String
  levelTitle      String
  totalXp         Int      @default(0)
  certificateCode String   @unique
  issuedAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certificateCode])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Passport {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentLevel  String   @default("A1")
  totalXp       Int      @default(0)
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GemsWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  gems           Int      @default(100)
  totalPurchased Int      @default(0)
  totalSpent     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Int
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model StoreItem {
  id             String          @id @default(cuid())
  name           String
  description    String
  category       String
  price          Int
  imageUrl       String?
  isPremium      Boolean         @default(false)
  isLimited      Boolean         @default(false)
  availableUntil DateTime?
  metadata       Json?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  inventory      UserInventory[]

  @@index([category])
  @@index([isActive])
}

model UserInventory {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime  @default(now())
  item        StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model UserAvatar {
  id           String   @id @default(cuid())
  userId       String   @unique
  avatarId     String   @default("avatar_1")
  frameId      String?
  backgroundId String?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CommunityGroup {
  id          String        @id @default(cuid())
  name        String
  description String
  level       String
  imageUrl    String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  posts       Post[]
}

model GroupMember {
  id       String         @id @default(cuid())
  userId   String
  groupId  String
  joinedAt DateTime       @default(now())
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Post {
  id        String          @id @default(cuid())
  userId    String
  content   String
  type      String
  groupId   String?
  createdAt DateTime        @default(now())
  comments  Comment[]
  likes     Like[]
  group     CommunityGroup? @relation(fields: [groupId], references: [id])
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Challenge {
  id             String          @id @default(cuid())
  title          String
  description    String
  icon           String
  duration       String
  targetProgress Int
  rewardXp       Int
  rewardGems     Int
  badgeId        String?
  isActive       Boolean         @default(true)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime        @default(now())
  participants   UserChallenge[]
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  isClaimed   Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
}

model Message {
  id         String       @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  receiver   User         @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reports    UserReport[]

  @@index([senderId])
  @@index([receiverId])
}

model MessageRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  receiver   User     @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id             String    @id @default(cuid())
  reporterId     String
  reportedUserId String
  messageId      String?
  reason         String
  description    String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  message        Message?  @relation(fields: [messageId], references: [id])
  reported       User      @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User      @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedUserId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  privacySetting String   @default("friendsOnly")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  currentLevel     String             @default("A1")
  learningGoal     String             @default("conversation")
  dailyMinutes     Int                @default(15)
  weakAreas        Json               @default("[]")
  strongAreas      Json               @default("[]")
  preferredTopics  Json               @default("[\"Greetings\", \"Numbers\", \"Colors\"]")
  learningSpeed    String             @default("normal")
  lastAnalysisDate DateTime           @default(now())
  totalStudyHours  Int                @default(0)
  currentStreak    Int                @default(0)
  overallProgress  Float              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  recommendations  AIRecommendation[]
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentMemory    StudentMemory?
  studyPlans       StudyPlan[]

  @@index([userId])
  @@index([currentLevel])
  @@index([learningGoal])
}

model AIRecommendation {
  id               String          @id @default(cuid())
  userId           String
  type             String
  title            String
  description      String
  category         String
  estimatedMinutes Int             @default(5)
  priority         Int             @default(5)
  isCompleted      Boolean         @default(false)
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  profile          LearningProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isCompleted])
}

model StudyPlan {
  id        String          @id @default(cuid())
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  days      Json
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  profile   LearningProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model StudentMemory {
  id                  String          @id @default(cuid())
  userId              String          @unique
  mistakePatterns     Json            @default("[]")
  successfullyLearned Json            @default("[]")
  conversationHistory Json            @default("[]")
  preferences         Json            @default("{\"audioEnabled\": true, \"feedbackStyle\": \"gentle\", \"favoriteTopics\": [], \"showTranslations\": true, \"preferredDifficulty\": \"intermediate\"}")
  lastUpdated         DateTime        @default(now())
  createdAt           DateTime        @default(now())
  profile             LearningProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model AiConversation {
  id            String   @id @default(cuid())
  userId        String
  message       String
  response      String
  category      String   @default("free")
  level         String   @default("A1")
  hasCorrection Boolean  @default(false)
  xpEarned      Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiLearningMemory {
  id              String   @id @default(cuid())
  userId          String
  mistakeType     String
  wrongSentence   String
  correctSentence String
  explanation     String
  languageLevel   String   @default("A1")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MockExam {
  id                String    @id @default(cuid())
  userId            String
  level             String
  score             Int       @default(0)
  totalPoints       Int       @default(0)
  timeSpentSeconds  Int       @default(0)
  completedSections Json      @default("[]")
  result            Json      @default("{}")
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([level])
}

model WritingSubmission {
  id             String   @id @default(cuid())
  userId         String
  level          String   @default("A1")
  prompt         String
  submissionText String
  feedback       Json     @default("{}")
  score          Int      @default(0)
  submittedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
