rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - only authenticated users can read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Curriculum data - readable by authenticated users, writable only by admins
    match /curriculum/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only via Admin SDK or Cloud Functions
    }

    // Questions - readable by authenticated users
    match /questions/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
