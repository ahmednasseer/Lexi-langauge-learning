# ===== Lexi Environment =====

# API
API_BASE_URL=https://api.lexi.com/api/v1

# Firebase
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=lexi-project.firebaseapp.com
FIREBASE_PROJECT_ID=lexi-project
FIREBASE_STORAGE_BUCKET=lexi-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# OpenAI (for direct client-side calls if needed)
OPENAI_API_KEY=sk-your-key

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
